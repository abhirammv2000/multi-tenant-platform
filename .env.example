# Copy to .env and fill in for local dev.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5435/mtp
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5435/mtp
ENV=dev

# generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_SECRET=
ADMIN_SECRET_KEY=

# Phase 2+: the Kubernetes cluster this control plane manages, and the registry tenant
# build images get pushed to (the platform's own credentials, not per-tenant).
KUBECONFIG_PATH=
IN_CLUSTER=false
IMAGE_REGISTRY=
REGISTRY_SERVER=
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
PLATFORM_CLUSTER_BUILDER_NAME=platform-builder
